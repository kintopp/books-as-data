cff-version: 1.2.0
message: "If you use this software in your research, please cite it as below."
type: software
title: "Books as Data MCP Server"
abstract: >
  An MCP server providing AI-mediated access to Books as Data, the joint
  platform of the UB Bern, the UB Basel, the ZHB Luzern and the ZB Zürich
  (750k+ titles, 1700–1900), supporting relevance-ranked and faceted search,
  full record detail with citations, cross-tabulated counts, OCR full text,
  locating phrases on scanned pages, and inspecting page images.
authors:
  - family-names: Bosse
    given-names: Arno
    orcid: "https://orcid.org/0000-0003-3681-1289"
    affiliation: "Research and Infrastructure Support (RISE), University of Basel"
repository-code: "https://github.com/kintopp/books-as-data"
url: "https://books-as-data-test.up.railway.app/mcp"
license: MIT
version: "0.30.2"
date-released: "2026-11-24"
keywords:
  - digital humanities
  - digitised books
  - OCR full text
  - IIIF
  - Swiss libraries
  - model context protocol
  - Books as Data
references:
  - type: software
    title: "Claude Code"
    authors:
      - name: "Anthropic"
    url: "https://www.anthropic.com"
    notes: "AI coding assistant used in the development of this software"
  - type: database
    title: "Books as Data"
    authors:
      - name: "Universitätsbibliothek Bern"
      - name: "Universitätsbibliothek Basel"
      - name: "Zentral- und Hochschulbibliothek Luzern"
      - name: "Zentralbibliothek Zürich"
    url: "https://books-as-data.ch/en"
    notes: "Joint platform of four Swiss libraries, coordinated by UB Basel. Queried live through its public GraphQL, full-text and IIIF services. Rights vary per item: the Google Books scans and OCR texts carry 'No Copyright – Non-Commercial Use Only' (https://rightsstatements.org/page/NoC-NC/1.0/) under a contractual embargo that forbids redistribution; e-rara items carry the Public Domain Mark. See https://books-as-data.ch/en/terms-of-use."
